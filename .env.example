# ============================================
# Joblynk Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# App
APP_ENV=production
APP_URL=https://yourdomain.co.za
APP_NAME=Joblynk
EMAIL_VERIFICATION_REQUIRED=true

# Database (Afrihost MySQL)
DB_HOST=localhost
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# Email — AWS SES (HTTPS API v2, SigV4). The IAM user needs ses:SendEmail.
AWS_SES_REGION=eu-west-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# A verified SES sender or domain identity:
MAIL_FROM_EMAIL=no-reply@yourdomain.co.za
MAIL_FROM_NAME=JobLynk
# Optional SES configuration set (bounce/complaint/open tracking):
AWS_SES_CONFIGURATION_SET=
# Secret used to sign one-click unsubscribe links — set a long random value:
MAIL_SECRET=
# Shared secret for the reminder/recommendation cron endpoints over HTTP:
MAIL_CRON_SECRET=
# Notification tuning (optional):
REMINDER_AFTER_DAYS=7
RECO_JOB_WINDOW_DAYS=10

# PayFast
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_SANDBOX=false

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxx

# DeepSeek AI (cover letters / CV import / job-ad copy)
# Preferred over the admin Settings key; keep it out of the database.
DEEPSEEK_API_KEY=

# Live job ingestion — weekly admin refresh (Adzuna ZA)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOBS_SYNC_ENABLED=1
# Optional: max API calls per refresh (Adzuna free tier ≈ 250/day)
ADZUNA_MAX_API_CALLS=180
ADZUNA_MAX_PAGES_PER_QUERY=5
# Optional: only needed for automated HTTP/CLI cron triggers
SYNC_SECRET=
SYSTEM_USER_ID=
